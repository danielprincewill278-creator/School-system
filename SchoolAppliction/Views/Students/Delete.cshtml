@model StudentEntity

<form asp-action="DeleteStudent" method="Delete">
    <input asp-for="Id" Hidden />
    <br />
    <div class="container border p-3" >
        <h1 class="text-primary">View/Update Student Details</h1>

        <hr />
        <div class="row">
            
                <div class="col-2">
                    <label asp-for="StudentName" class="control-label pt-2" style="font-size:14px;"></label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="StudentName" class="control-label pt-2" readonly">
                   
                </div>
                <div class="col-2">
                    <label asp-for="Class" class="control-label pt-2" style="font-size:14px;"></label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="Class" class="control-label pt-2" readonly">
                    
                </div>
                <div class="col-2">
                    <label asp-for="Age" class="control-label pt-2" style="font-size:14px;"></label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="Age" class="control-label pt-2" readonly">
                   
                </div>
                <div class="col-2">
                    <label asp-for="Email" class="control-label pt-2" style="font-size:14px;"></label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="Email" class="control-label pt-2" readonly">
                    
                </div>
                <div class="col-2">
                    <label asp-for="DOB" class="control-label pt-2" style="font-size:14px;"></label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="DOB" class="control-label pt-2" readonly">
                   
                </div>

                <br />
                <div class="col-5">
                <a asp-action="index" asp-controller="Students" class="btn btn-primary form-control">Back To List </a>
                </div>
                <div class="col-5 offset-2">
                <input type="submit" value="Delete" class="btn btn-danger form-control" />
                </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
